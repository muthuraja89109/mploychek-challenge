# Copy this file to ".env" and fill it in.
PORT=3000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mploychek
# Or MongoDB Atlas (free tier):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mploychek

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Where the Angular app runs (for CORS)
CLIENT_ORIGIN=http://localhost:4200
